{
  "name": "spatial-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "dev:server": "node server/index.mjs",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:draft1": "node scripts/test-idempotency.mjs && node scripts/test-draft1.mjs",
    "test:workspace": "node scripts/test-gesture-workspace.mjs",
    "test:camera-gestures": "node scripts/test-camera-gestures.mjs",
    "bench:gesture": "node scripts/bench-gesture.mjs",
    "bench:features": "node scripts/bench-features.mjs",
    "bench": "node scripts/bench-gesture.mjs && node scripts/bench-hand.mjs && node scripts/bench-features.mjs",
    "bench:hand": "node scripts/bench-hand.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "fastify": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
